# ==============================================================================
# Environment Variables & Secrets (CRITICAL)
# ==============================================================================
# Ignore all local env files (Next.js / Create React App standards)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Allow committing example/template env files
!*.env.example
!*.env.template
!*.env.sample

# ==============================================================================
# Logs and Debug
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

