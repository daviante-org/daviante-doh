# ==============================================================================
coverage/
.nyc_output/
.jest-cache/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# ==============================================================================
# Package Manager Configurations (Yarn 2+ / Berry)
# ==============================================================================
# Ignore yarn core, but keep specific directories for Zero-Installs if needed
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

