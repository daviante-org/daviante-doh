node_modules/
.pnp
.pnp.js
.pnp.cjs

# ==============================================================================
# Build Outputs & Caches (React, Next.js, Vite, Webpack)
# ==============================================================================
# Standard build directories
build/
dist/
out/
lib/

# Framework-specific caches and builds
.next/
.nuxt/
.cache/
