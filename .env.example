# =============================================================================
# daviante-doh (by Daviante - https://daviante.org) Environment Configuration
# Optional enterprise features are OFF by default unless enabled below.
# =============================================================================

# Socket address and port for daviante-doh to listen on inside the container
DOH_LISTEN_ADDRESS=0.0.0.0:3000

# Optional dedicated admin listener for /metrics, /livez, /readyz, and /healthz
DOH_ADMIN_LISTEN_ADDRESS=

# Upstream UDP/TCP DNS resolver(s) (comma-separated for automatic failover, e.g. 9.9.9.9:53,1.1.1.1:53)
DOH_SERVER_ADDRESS=9.9.9.9:53

# Optional outbound local bind address (e.g. 0.0.0.0:0)
DOH_LOCAL_BIND_ADDRESS=

# Optional public hostname (e.g. doh.example.com — generates DoH and ODoH DNS stamps on startup)
DOH_HOSTNAME=

# Optional comma/space-separated public IP addresses for DNS stamp generation
DOH_PUBLIC_ADDRESS=

# Optional external port if not 443
DOH_PUBLIC_PORT=

# Endpoint URI paths
DOH_PATH=/dns-query
DOH_ODOH_CONFIGS_PATH=/.well-known/odohconfigs
DOH_HEALTH_PATH=/healthz

# First-party Prometheus / OpenMetrics endpoint (off by default)
DOH_ENABLE_METRICS=false
DOH_METRICS_PATH=/metrics

# Connection, stream, and graceful shutdown limits
DOH_MAX_CLIENTS=512
DOH_MAX_CONCURRENT=16
DOH_MAX_CONNS_PER_IP=0
DOH_TIMEOUT=10
DOH_SHUTDOWN_GRACE_PERIOD=15

# HTTP & In-Memory DNS Caching (DOH_CACHE_SIZE=0 disables in-memory cache by default)
DOH_MIN_TTL=0
DOH_MAX_TTL=604800
DOH_ERR_TTL=2
DOH_STALE_IF_ERROR_SECS=0
DOH_STALE_WHILE_REVALIDATE_SECS=0
DOH_CACHE_SIZE=0

# Protocol & Security Feature toggles (true / false / 1 / 0 / yes / no / on / off)
DOH_DISABLE_KEEPALIVE=false
DOH_DISABLE_POST=false
DOH_ALLOW_ODOH_POST=false
DOH_DISABLE_ANY=false

# RFC 7871 EDNS Client Subnet & Trusted Reverse Proxies (off by default)
DOH_ENABLE_ECS=false
DOH_TRUSTED_PROXIES=
DOH_ECS_PREFIX_V4=24
DOH_ECS_PREFIX_V6=56

# RFC 9230 Oblivious DoH key rotation interval (in seconds, 60..=604800)
DOH_ODOH_ROTATION_SECS=86400

# Enterprise Protective DNS Domain Policy (Allowlist / Blocklist + RFC 8914 EDE - off by default)
DOH_ALLOWLIST_FILE=
DOH_BLOCKLIST_FILE=
DOH_BLOCK_ACTION=nxdomain

# Per-Client IP Token-Bucket Rate Limiting (0 = disabled by default)
DOH_RATE_LIMIT_RPS=0
DOH_RATE_LIMIT_BURST=20
DOH_RATE_LIMIT_V6_PREFIX=64

# Enterprise CORS & Structured Logging (RFC 8932 privacy defaults)
DOH_CORS_ALLOW_ORIGIN=*
DOH_LOG_QUERIES=false
DOH_LOG_CLIENT_IP=false
DOH_LOG_FORMAT=json
DOH_LOG_LEVEL=info

# Optional built-in TLS (PEM certificate chain, private key paths, and min protocol version 1.2 or 1.3)
DOH_TLS_CERT_PATH=
DOH_TLS_CERT_KEY_PATH=
DOH_TLS_MIN_VERSION=1.2
